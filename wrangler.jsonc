{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pemo-cv",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/pemo-cv/browser",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
